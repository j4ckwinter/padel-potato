{
  "expo": {
    "name": "Padel Potato",
    "slug": "padel-potato",
    "scheme": "padel-potato",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": ["expo-router", "expo-splash-screen", "expo-secure-store"]
  }
}
