{
  "expo": {
    "name": "Padel Potato",
    "slug": "padel-potato",
    "scheme": "padel-potato",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.padelpotato.app"
    },
    "android": {
      "package": "com.padelpotato.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-web-browser",
      "expo-notifications"
    ]
  }
}
