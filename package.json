{
  "name": "padel-potato",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "validate:phase2-verification": "node scripts/validate-phase-2-verification.mjs",
    "verify:phase2": "npm run typecheck && npm run lint && npm test -- --runInBand && node scripts/validate-penpot-evidence.mjs && node scripts/validate-penpot-assets.mjs && node scripts/validate-toolchain-compatibility.mjs && npm run validate:phase2-verification && npm run storybook:web:smoke",
    "storybook:native": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:web": "cross-env STORYBOOK_ENABLED=true expo start --web",
    "storybook:web:smoke": "node scripts/smoke-storybook-web.mjs",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "57.0.24",
    "expo-font": "57.0.4",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@storybook/addon-ondevice-actions": "10.5.0",
    "@storybook/addon-ondevice-backgrounds": "10.5.0",
    "@storybook/addon-ondevice-controls": "10.5.0",
    "@storybook/react": "10.5.0",
    "@storybook/react-native": "10.5.0",
    "@storybook/react-native-theming": "10.5.0",
    "@storybook/react-native-ui": "10.5.0",
    "@storybook/react-native-ui-common": "10.5.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.7",
    "storybook": "10.5.0",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo"
  }
}
