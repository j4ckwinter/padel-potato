{
  "name": "padel-potato",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "format": "prettier --write app.json eslint.config.js metro.config.js package.json tsconfig.json .rnstorybook src tests scripts",
    "format:check": "prettier --check app.json eslint.config.js metro.config.js package.json tsconfig.json .rnstorybook src tests scripts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "supabase:test": "npx supabase db reset && node scripts/verify-supabase.mjs && node scripts/verify-game-management.mjs && node scripts/verify-social.mjs && node scripts/verify-auth-recovery.mjs",
    "supabase:types": "node scripts/generate-supabase-types.mjs",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm test -- --runInBand && npm run storybook:web:smoke",
    "storybook:native": "cross-env STORYBOOK_ENABLED=true expo start",
    "storybook:web": "cross-env STORYBOOK_ENABLED=true expo start --web",
    "storybook:web:smoke": "node scripts/smoke-storybook-web.mjs",
    "storybook:ios": "cross-env STORYBOOK_ENABLED=true expo start --ios",
    "storybook:android": "cross-env STORYBOOK_ENABLED=true expo start --android"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@gorhom/bottom-sheet": "5.2.14",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.25",
    "expo-auth-session": "~57.0.13",
    "expo-constants": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@storybook/addon-ondevice-actions": "10.5.0",
    "@storybook/addon-ondevice-backgrounds": "10.5.0",
    "@storybook/addon-ondevice-controls": "10.5.0",
    "@storybook/react": "10.5.0",
    "@storybook/react-native": "10.5.0",
    "@storybook/react-native-theming": "10.5.0",
    "@storybook/react-native-ui": "10.5.0",
    "@storybook/react-native-ui-common": "10.5.0",
    "@testing-library/react-native": "14.0.1",
    "@types/react": "19.2.4",
    "cross-env": "10.1.0",
    "eslint": "9.39.2",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.9.7",
    "storybook": "10.5.0",
    "supabase": "2.118.0",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
